{
	"name": "PyOBD",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",

	"postCreateCommand": "pip3 install --user -r requirements.txt",

	"customizations": {
		"vscode": {
			"settings": {
				"github.copilot.chat.codeGeneration.instructions": [
					{
						"text": "Always read and follow the guidelines in the AGENTS.md file in the workspace root before suggesting code changes or implementations."
					}
				]
			},
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter"
			]
		}
	}
}
